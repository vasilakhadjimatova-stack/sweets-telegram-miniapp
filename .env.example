# Telegram Bot API Token (Get it from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Web App URL (HTTPS URL where index.html, style.css, app.js and assets/ are hosted)
# Example: https://yourusername.github.io/sweets-shop/
WEB_APP_URL=https://your-domain.com

# Telegram Chat/Group ID where order notifications should be sent to admins
# Can be a group chat ID (e.g. -100123456789) or channel ID.
# Keep empty if you only want the user to receive receipts.
ADMIN_GROUP_ID=

# SQLite database file path (optional).
# Default: ./data/sweets.db — the file and folder are created automatically.
DATABASE_PATH=
